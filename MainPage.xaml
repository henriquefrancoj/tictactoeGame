<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiJogoDaVelha.MainPage"
             BackgroundColor="#F4F7FC">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#DCE7F7"/>
            <Setter Property="TextColor" Value="#3478F6"/>
            <Setter Property="FontSize" Value="60"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="BorderWidth" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*" Padding="24" RowSpacing="20">
        <Label Grid.Row="0" Text="Jogo da Velha" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#24344A"/>
        <Label Grid.Row="1" x:Name="lblVez" Text="Vez do jogador: X" FontSize="20" HorizontalOptions="Center" TextColor="#3478F6"/>
        <Grid Grid.Row="2" RowDefinitions="*,*,*" ColumnDefinitions="*,*,*" ColumnSpacing="10" RowSpacing="10" Margin="15">
            <Button x:Name="btn10" Grid.Row="0" Grid.Column="0" Clicked="Button_Clicked"/>
            <Button x:Name="btn11" Grid.Row="0" Grid.Column="1" Clicked="Button_Clicked"/>
            <Button x:Name="btn12" Grid.Row="0" Grid.Column="2" Clicked="Button_Clicked"/>

            <Button x:Name="btn20" Grid.Row="1" Grid.Column="0" Clicked="Button_Clicked"/>
            <Button x:Name="btn21" Grid.Row="1" Grid.Column="1" Clicked="Button_Clicked"/>
            <Button x:Name="btn22" Grid.Row="1" Grid.Column="2" Clicked="Button_Clicked"/>

            <Button x:Name="btn30" Grid.Row="2" Grid.Column="0" Clicked="Button_Clicked"/>
            <Button x:Name="btn31" Grid.Row="2" Grid.Column="1" Clicked="Button_Clicked"/>
            <Button x:Name="btn32" Grid.Row="2" Grid.Column="2" Clicked="Button_Clicked"/>
        </Grid>
        <Button Grid.Row="3" Text="Reiniciar partida" BackgroundColor="#3478F6" TextColor="White"
        FontSize="16" CornerRadius="12" HeightRequest="50" Clicked="Reiniciar_Clicked"/>
    </Grid>
</ContentPage>
